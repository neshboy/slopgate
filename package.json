{
  "name": "slopgate",
  "version": "0.1.0",
  "description": "A GitHub Action + CLI that scores incoming PRs for cheap, honest, deterministic AI-slop signals and labels them for maintainer triage.",
  "license": "MIT",
  "author": "SlopGate contributors",
  "type": "commonjs",
  "bin": {
    "slopgate": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:check": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
